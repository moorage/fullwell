# Application
NODE_ENV=development
HOST=127.0.0.1
PORT=4173
PUBLIC_ORIGIN=http://127.0.0.1:4173
AUTH_MODE=test
HOUSEHOLD_REPOSITORY_ROOT=.local/households
HOUSEHOLD_WORKTREE_ROOT=.local/worktrees

# Neon PostgreSQL. Use an isolated development branch, never production credentials.
DATABASE_URL=
DATABASE_DIRECT_URL=

# Authentication and delivery providers
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
MAIL_PROVIDER_API_KEY=
MAIL_FROM=Fullwell <sign-in@example.com>
SESSION_SECRET=
TOKEN_PEPPER=

# Git signing and encrypted off-site backup
GIT_SIGNING_KEY=
BACKUP_ENCRYPTION_KEY=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

{
  "name": "@hfj/web",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    "./server": {
      "types": "./src/server.tsx",
      "default": "./dist/server/server.js"
    },
    "./types": "./src/types.ts"
  },
  "scripts": {
    "build": "vite build && vite build --ssr src/server.tsx --outDir dist/server",
    "dev": "vite --host 127.0.0.1",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "lucide-react": "^0.468.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}

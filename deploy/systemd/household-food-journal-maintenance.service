[Unit]
Description=Household Food Journal idempotent maintenance
After=household-food-journal.service
Requires=household-food-journal.service

[Service]
Type=oneshot
WorkingDirectory=/opt/household-food-journal/deploy
EnvironmentFile=/etc/hfj/deploy.env
Environment=DEPLOY_CREDENTIALS_DIRECTORY=/run/household-food-journal/credentials
ExecStartPre=/opt/household-food-journal/deploy/scripts/verify-volume.sh
ExecStart=/usr/bin/docker compose exec -T app npm run maintenance --workspace @hfj/server
TimeoutStartSec=7200

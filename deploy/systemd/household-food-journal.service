[Unit]
Description=Household Food Journal single-writer service
After=docker.service network-online.target data-households.mount
Wants=network-online.target
Requires=docker.service data-households.mount
ConditionPathIsMountPoint=/data/households

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/household-food-journal/deploy
EnvironmentFile=/etc/hfj/deploy.env
Environment=DEPLOY_CREDENTIALS_DIRECTORY=/run/household-food-journal/credentials
RuntimeDirectory=household-food-journal/credentials
RuntimeDirectoryMode=0750
LoadCredentialEncrypted=database-url:/etc/credstore.encrypted/hfj-database-url
LoadCredentialEncrypted=database-direct-url:/etc/credstore.encrypted/hfj-database-direct-url
LoadCredentialEncrypted=token-pepper:/etc/credstore.encrypted/hfj-token-pepper
LoadCredentialEncrypted=session-secret:/etc/credstore.encrypted/hfj-session-secret
LoadCredentialEncrypted=operator-token:/etc/credstore.encrypted/hfj-operator-token
LoadCredentialEncrypted=apple-private-key:/etc/credstore.encrypted/hfj-apple-private-key
LoadCredentialEncrypted=mail-provider-api-key:/etc/credstore.encrypted/hfj-mail-provider-api-key
LoadCredentialEncrypted=openai-review-username:/etc/credstore.encrypted/hfj-openai-review-username
LoadCredentialEncrypted=openai-review-password:/etc/credstore.encrypted/hfj-openai-review-password
LoadCredentialEncrypted=openai-apps-challenge:/etc/credstore.encrypted/hfj-openai-apps-challenge
LoadCredentialEncrypted=git-signing-key:/etc/credstore.encrypted/hfj-git-signing-key
LoadCredentialEncrypted=git-allowed-signers:/etc/credstore.encrypted/hfj-git-allowed-signers
LoadCredentialEncrypted=object-storage-access-key-id:/etc/credstore.encrypted/hfj-object-storage-access-key-id
LoadCredentialEncrypted=object-storage-secret-access-key:/etc/credstore.encrypted/hfj-object-storage-secret-access-key
LoadCredentialEncrypted=backup-encryption-key:/etc/credstore.encrypted/hfj-backup-encryption-key
LoadCredentialEncrypted=backup-manifest-private-key:/etc/credstore.encrypted/hfj-backup-manifest-private-key
LoadCredentialEncrypted=backup-manifest-public-key:/etc/credstore.encrypted/hfj-backup-manifest-public-key
LoadCredentialEncrypted=whatsapp-business-account-id:/etc/credstore.encrypted/hfj-whatsapp-business-account-id
LoadCredentialEncrypted=whatsapp-phone-number-id:/etc/credstore.encrypted/hfj-whatsapp-phone-number-id
LoadCredentialEncrypted=whatsapp-contact-url:/etc/credstore.encrypted/hfj-whatsapp-contact-url
LoadCredentialEncrypted=whatsapp-app-secret:/etc/credstore.encrypted/hfj-whatsapp-app-secret
LoadCredentialEncrypted=whatsapp-access-token:/etc/credstore.encrypted/hfj-whatsapp-access-token
LoadCredentialEncrypted=whatsapp-verify-token:/etc/credstore.encrypted/hfj-whatsapp-verify-token
LoadCredentialEncrypted=message-encryption-key:/etc/credstore.encrypted/hfj-message-encryption-key
ExecStartPre=/opt/household-food-journal/deploy/scripts/verify-volume.sh
ExecStartPre=/opt/household-food-journal/deploy/scripts/materialize-credentials.sh
ExecStartPre=/usr/bin/docker compose config --quiet
ExecStart=/usr/bin/docker compose up --detach --force-recreate --remove-orphans --wait
ExecStop=/usr/bin/docker compose down --timeout 30
TimeoutStartSec=180
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target

{
  "name": "household-food-journal",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @hfj/contracts && npm run build --workspaces --if-present",
    "dev": "npm run dev --workspace @hfj/server",
    "start": "npm run start --workspace @hfj/server",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "test:git-hooks": "node scripts/git-hooks/commit-msg.test.mjs && node scripts/security/check-sensitive-content.test.mjs",
    "test:app": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:contract": "vitest run --project contracts && npm run test:packaging",
    "test:integration": "vitest run tests/integration apps/server --config vitest.integration.config.ts",
    "test:security": "vitest run tests/security",
    "test:load": "vitest run tests/load",
    "test:packaging": "npm run test:packaging --workspace @fullwell/fullwell",
    "test:evals": "npm run test:evals --workspace @fullwell/fullwell",
    "test:e2e": "playwright test",
    "test:accessibility": "playwright test tests/e2e/accessibility.spec.ts",
    "test:restore": "vitest run tests/restore",
    "test:deploy-smoke": "node scripts/ci/deploy-smoke.mjs",
    "test:messaging-smoke": "node scripts/ci/messaging-smoke.mjs",
    "test:persistence-smoke": "node scripts/ci/persistence-smoke.mjs",
    "test:migrations": "node scripts/ci/test-migrations.mjs",
    "test:mcp-smoke": "node scripts/ci/mcp-smoke.mjs",
    "migrate": "node scripts/ci/apply-migrations.mjs",
    "verify": "npm run verify:sensitive && npm run build && npm run lint && npm run typecheck && npm run test:unit && npm run test:app && npm run verify:ideas && npm run verify:docs && npm run verify:execplan",
    "verify:sensitive": "node scripts/security/check-sensitive-content.mjs",
    "verify:ideas": "python3 scripts/check_ideation.py",
    "verify:docs": "python3 scripts/knowledge/check_docs.py",
    "verify:execplan": "python3 scripts/check_execplan.py",
    "knowledge:refresh": "python3 scripts/knowledge/generate_repo_map.py && python3 scripts/knowledge/update_quality_ledger.py",
    "knowledge:suggest": "python3 scripts/knowledge/suggest_doc_updates.py",
    "self-improve:distill": "node scripts/self-improvement/distill.mjs",
    "self-improve:context": "node scripts/self-improvement/update-context-ledger.mjs",
    "test:self-improvement": "node scripts/self-improvement/self-improvement.test.mjs",
    "test:knowledge": "python3 scripts/knowledge/suggest_doc_updates.test.py",
    "test:infrastructure": "node --test infra/opentofu/staging-baseline.test.mjs",
    "test:apple-container": "node scripts/local/apple-container.test.mjs",
    "test:unit": "npm run test:git-hooks && node scripts/ci/apply-migrations.test.mjs && node --test scripts/ci/messaging-smoke.test.mjs && node --test deploy/scripts/materialize-credentials.test.mjs deploy/caddy.test.mjs && npm run test:infrastructure && npm run test:apple-container && npm run test:self-improvement && npm run test:knowledge",
    "container:system:start": "node scripts/local/apple-container.mjs system:start",
    "container:postgres:start": "node scripts/local/apple-container.mjs postgres:start",
    "container:postgres:stop": "node scripts/local/apple-container.mjs postgres:stop",
    "container:postgres:status": "node scripts/local/apple-container.mjs postgres:status",
    "container:postgres:verify": "node scripts/local/apple-container.mjs postgres:verify",
    "container:build": "node scripts/local/apple-container.mjs image:build",
    "capture:screencast": "node scripts/ci/record_screencast.mjs",
    "capture:screencast:run": "node scripts/ci/run_with_screencast.mjs"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.54.1",
    "@types/node": "^24.0.15",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "3.2.7"
  },
  "overrides": {
    "test-exclude": "8.0.0"
  }
}

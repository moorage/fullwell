{
  "name": "@fullwell/local-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "fullwell-runner": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:packaging": "vitest run --config vitest.config.ts src/launchd.test.ts",
    "start": "node dist/cli.js run"
  },
  "dependencies": {
    "@hfj/contracts": "0.1.0",
    "fflate": "^0.8.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
